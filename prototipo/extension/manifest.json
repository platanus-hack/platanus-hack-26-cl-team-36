{
  "manifest_version": 3,
  "name": "Pieles (prototipo)",
  "version": "0.1.0",
  "description": "Adapta cada página que visitas a tu gusto con una piel de CSS generada por Claude en tu equipo.",
  "browser_specific_settings": {
    "gecko": {
      "id": "pieles-prototipo@grupo36.hackathon",
      "strict_min_version": "128.0"
    }
  },
  "permissions": ["scripting", "storage", "webNavigation", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["fondo.js"],
    "type": "module"
  },
  "action": {
    "default_title": "Pieles: adapta las páginas a tu gusto",
    "default_popup": "panel.html",
    "default_area": "navbar"
  }
}
