{
  "name": "chameleon-backoffice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Visor de solo lectura de las corridas del Visitante. node:http; el SDK de AWS solo para leer de S3 y DynamoDB.",
  "scripts": {
    "start": "node servidor.js",
    "dev": "node --watch servidor.js",
    "test": "node --test test/*.test.js",
    "mock": "node --watch mock/servir.js",
    "historial": "node historial.js --dry-run",
    "mock:generar": "uv run --project ../agents/app/visitor python mock/generar.py"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1175.0",
    "@aws-sdk/client-s3": "3.1175.0",
    "@aws-sdk/lib-dynamodb": "3.1175.0",
    "@aws-sdk/s3-request-presigner": "3.1175.0"
  }
}
