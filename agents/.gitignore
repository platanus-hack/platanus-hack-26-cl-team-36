# Recorridos, capturas y reportes de las corridas: datos locales, pesan y pueden
# mostrar páginas con información de quien corrió la prueba.
.runs/

# Credenciales locales (por ejemplo ANTHROPIC_API_KEY para --engine api).
.env
.env.*
!.env.example

# Entorno y cachés de Python.
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# Sistema operativo.
.DS_Store

# CLI de AgentCore (agentcore/): estado local, caché del empaquetado y salida de CDK.
# deployed-state.json sí se sube: enlaza el proyecto con su stack desplegado.
agentcore/.cli/*
!agentcore/.cli/deployed-state.json
agentcore/.cache/
agentcore/cdk/cdk.out/
node_modules/
