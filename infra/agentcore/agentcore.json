{
  "name": "ChameleonAgents",
  "version": 2,
  "managedBy": "CDK",
  "runtimes": [
    {
      "name": "web_evaluator_image",
      "description": "Usuarios sintéticos que intentan una tarea en un sitio y unen sus recorridos",
      "build": "Container",
      "entrypoint": "agentcore_app.py",
      "codeLocation": "../agents/app/visitor",
      "protocol": "HTTP",
      "lifecycleConfiguration": {
        "idleRuntimeSessionTimeout": 900,
        "maxLifetime": 3600
      },
      "connections": [
        {
          "id": "navegador",
          "to": {
            "type": "browser"
          },
          "description": "AgentCore Browser administrado por AWS: una sesión por usuario sintético"
        }
      ],
      "buildContextPath": "../agents",
      "dockerfile": "app/visitor/Dockerfile"
    }
  ],
  "memories": [],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [],
  "policyEngines": [],
  "configBundles": [],
  "harnesses": []
}