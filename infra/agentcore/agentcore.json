{
  "name": "ChameleonAgents",
  "version": 2,
  "managedBy": "CDK",
  "runtimes": [
    {
      "name": "chameleon",
      "description": "Una imagen con todas las etapas de una revisión: el payload elige cuál corre (stage)",
      "build": "Container",
      "entrypoint": "agentcore_app.py",
      "codeLocation": "../agents/app/runtime",
      "protocol": "HTTP",
      "lifecycleConfiguration": {
        "idleRuntimeSessionTimeout": 900,
        "maxLifetime": 28800
      },
      "connections": [
        {
          "id": "navegador",
          "to": {
            "type": "browser"
          },
          "description": "AgentCore Browser administrado por AWS: una sesión por etapa o usuario sintético"
        }
      ],
      "buildContextPath": "..",
      "dockerfile": "agents/app/runtime/Dockerfile"
    }
  ],
  "memories": [],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [],
  "policyEngines": [],
  "configBundles": [],
  "harnesses": []
}