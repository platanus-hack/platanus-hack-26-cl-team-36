# CLI de AgentCore (infra/ es su proyecto; la configuración está en agentcore/): estado local,
# caché del empaquetado y salida de CDK. deployed-state.json sí se sube: enlaza el proyecto con
# su stack desplegado.
agentcore/.cli/*
!agentcore/.cli/deployed-state.json
agentcore/.cache/
agentcore/cdk/cdk.out/
node_modules/

# Variables locales de `agentcore dev`; pueden tener secretos.
.env
.env.*
