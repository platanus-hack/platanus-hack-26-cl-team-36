# AWS environment: the chameleon runtime in AgentCore, through the AgentCore CLI (infra/agentcore/).
# From anywhere in the repo, as `just aws <command>`. They use your AWS credentials for the project
# account: export AWS_PROFILE=<profile>.
#
#   just aws revision https://www.wom.cl/      reviews a page on AWS and follows its stages
#   just aws deploy                            deploys from your computer (CI does it on every merge)
#   just aws seed [--force] [<url>...]         revisions on the deployed API (default: agents/tasks/demo.json)
#
# Recipes run from infra/, the AgentCore CLI project: its configuration is in infra/agentcore/ and the
# code it deploys in agents/ (image from agents/app/runtime/Dockerfile, with the repo root as context).

set positional-arguments

agentcore := "../node_modules/.bin/agentcore"
list_heading := "Run as `just aws <command>`, with AWS_PROFILE set to the project account:\n"
# The deployed runtime: <project>_<target>_<runtime>. The CLI only finds it by its name in agentcore.json on the
# computer that deployed it, and CI deploys, so status and logs look it up in AWS instead.
runtime_name := "ChameleonAgents_default_chameleon"
runtime_arn := "aws bedrock-agentcore-control list-agent-runtimes --query \"agentRuntimes[?agentRuntimeName=='" + runtime_name + "'].agentRuntimeArn | [0]\" --output text"

# The API and its table (infra/app/).
api_function := "chameleon-backend"
table := "chameleon-revisiones"

# What `just aws` alone runs.
[private]
[default]
help:
    @just --list aws --unsorted --list-heading '{{ list_heading }}'

# Reviews a page through the API (POST /revisiones) and follows its stages; saves tema.css in local/.state/aws/. --force reviews it again
[group('Revisions on AgentCore · Claude on Bedrock, billed to the AWS account')]
revision url force="":
    #!/usr/bin/env bash
    set -euo pipefail
    [[ -z "$2" || "$2" == "--force" ]] || { echo "usage: just aws revision <url> [--force]" >&2; exit 1; }
    api=$(aws lambda get-function-url-config --function-name {{ api_function }} --query FunctionUrl --output text)
    api="${api%/}"
    body=$(node -e 'console.log(JSON.stringify({url: process.argv[1], force: process.argv[2] === "--force"}))' "$1" "$2")
    answer=$(curl -sS --fail-with-body -X POST "$api/revisiones" -H 'content-type: application/json' -d "$body")
    revision=$(node -p 'JSON.parse(process.argv[1]).revision' "$answer")
    echo "revision $revision"
    # The projector copies each manifest from S3 to the revision's rows in DynamoDB: META and one per stage.
    seen="$(mktemp)"
    trap 'rm -f "$seen"' EXIT
    while :; do
        status=$(aws dynamodb query --table-name {{ table }} --key-condition-expression 'PK = :pk' \
            --expression-attribute-values "{\":pk\":{\"S\":\"REV#$revision\"}}" --output json | node -e '
                const fs = require("fs"), seen = process.argv[1];
                const before = new Set(fs.readFileSync(seen, "utf8").split("\n"));
                const items = JSON.parse(fs.readFileSync(0, "utf8")).Items;
                const name = (sk) => (sk === "META" ? "revision" : sk.replace(/^(STAGE|GOAL)#/, ""));
                const lines = items.map((i) => `${name(i.SK.S)}: ${i.status?.S}`);
                const time = new Date().toTimeString().slice(0, 8);
                for (const line of lines.filter((l) => !before.has(l))) console.error(`${time}  ${line}`);
                fs.writeFileSync(seen, lines.join("\n"));
                console.log(items.find((i) => i.SK.S === "META")?.status?.S ?? "queued");' "$seen")
        [[ "$status" == done || "$status" == failed ]] && break
        sleep 15
    done
    [ "$status" == done ] || { echo "The revision failed: just aws logs shows why." >&2; exit 1; }
    out="local/.state/aws/$revision"
    mkdir -p "../$out"
    curl -sS --fail-with-body "$api/revisiones?url=$(node -p 'encodeURIComponent(process.argv[1])' "$1")" \
        | node -e 'process.stdout.write(JSON.parse(require("fs").readFileSync(0, "utf8")).css ?? "")' > "../$out/tema.css"
    echo "tema.css: $out/tema.css"

# Revisions on the deployed API, followed until done or failed. Without URLs, agents/tasks/demo.json. Options: --force, --api <url>, --tope-min <minutes>
[group('Revisions on the deployed API · no AWS credentials needed')]
seed *args:
    @node siembra/sembrar.js "$@"

# Deploys the chameleon runtime to AgentCore from your computer. CI does the same on every merge to main
[group('Deploy')]
deploy: _ready
    {{ agentcore }} deploy

# What is deployed: the runtime, its version, its status and when it was last updated
[group('Deploy')]
status:
    #!/usr/bin/env bash
    set -euo pipefail
    runtime=$({{ runtime_arn }})
    [[ "$runtime" == arn:* ]] || { echo "{{ runtime_name }} is not deployed in this account" >&2; exit 1; }
    aws bedrock-agentcore-control get-agent-runtime --agent-runtime-id "${runtime##*/}" --output table \
        --query '{name: agentRuntimeName, status: status, version: agentRuntimeVersion, updated: lastUpdatedAt}'

# The runtime logs from the last 30 minutes. E.g. just aws logs --follow, or just aws logs --since 2h
[group('Deploy')]
logs *options:
    #!/usr/bin/env bash
    set -euo pipefail
    runtime=$({{ runtime_arn }})
    [[ "$runtime" == arn:* ]] || { echo "{{ runtime_name }} is not deployed in this account" >&2; exit 1; }
    aws logs tail "/aws/bedrock-agentcore/runtimes/${runtime##*/}-DEFAULT" --since 30m --format short "$@"

[private]
_ready:
    @test -x {{ agentcore }} || { echo "The AgentCore CLI is missing: run \`just local setup\` first." >&2; exit 1; }
