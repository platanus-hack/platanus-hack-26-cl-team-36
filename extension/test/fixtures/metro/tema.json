{
  "nombre": "Metro de Santiago — kit de viaje",
  "features": {
    "vista": [
      {
        "id": "planificar",
        "rutas": ["/"],
        "contenedor": "body > div:has(> #home)",
        "reemplazar": false,
        "componente": "atajo",
