            "enlace": "/el-viaje/horarios-y-tarifas"
          },
          {
            "titulo": { "es": "Carga tu bip!", "en": "Top up your bip!" },
            "detalle": { "es": "Recarga saldo para viajar", "en": "Add credit to travel" },
            "enlace": "/el-viaje/carga-bip"
          },
          {
            "titulo": { "es": "Estaciones", "en": "Stations" },
            "detalle": { "es": "Información de cada estación", "en": "Details for every station" },
            "enlace": "/el-viaje/estaciones"
