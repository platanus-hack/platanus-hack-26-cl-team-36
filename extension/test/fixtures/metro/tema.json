          { "nombre": "horario", "etiqueta": { "es": "Horario", "en": "Time band" }, "opciones": "#horario" },
          { "nombre": "dia", "etiqueta": { "es": "Día", "en": "Day" }, "opciones": "#dia" }
        ],
        "opciones": {
          "destino": "/el-viaje/planificador/",
          "invertir": ["inicio", "fin"],
          "textos": {
            "es": {
              "titulo": "¿A dónde vas?",
              "subtitulo": "Elige tus estaciones y te mostramos la ruta y el tiempo de viaje.",
              "boton": "Ver ruta",
              "invertir": "Intercambiar origen y destino"
            },
            "en": {
              "titulo": "Where are you going?",
              "subtitulo": "Pick your stations and we'll show you the route and travel time.",
              "boton": "See route",
              "invertir": "Swap origin and destination"
            }
          }
        }
      },
      {
        "id": "tareas",
