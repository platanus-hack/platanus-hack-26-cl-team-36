{
  "manifest_version": 3,
  "name": "Chameleon Mode",
  "version": "0.1.0",
  "description": "Adapta la presentación de los sitios compatibles y permite compartir tu opinión sobre la experiencia.",

  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },

  "permissions": ["storage", "scripting"],

  "host_permissions": ["http://*/*", "https://*/*"],

  "background": {
    "scripts": ["background/index.js"],
    "service_worker": "background/index.js",
    "type": "module"
  },

  "action": {
    "default_title": "Chameleon Mode",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/extension-on-16.png",
      "32": "icons/extension-on-32.png"
    }
  },

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "css": ["features/modo-foco.css", "features/vista.css", "componentes/cartelera.css", "componentes/lanzador.css", "componentes/atajo.css", "componentes/buscador.css", "content/transicion.css"],
      "js": [
        "content/registro.js",
        "comun/idioma.js",
        "comun/efectos.js",
        "content/captura.js",
        "content/plantillas.js",
        "content/transicion.js",
        "componentes/cartelera.js",
        "componentes/lanzador.js",
        "componentes/atajo.js",
        "componentes/buscador.js",
        "features/modo-foco.js",
        "features/vista.js",
        "content/motor.js"
      ],
      "run_at": "document_start"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["fuentes/*.woff2"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],

  "minimum_chrome_version": "148",

  "browser_specific_settings": {
    "gecko": {
      "id": "chameleon@grupo36.hackathon",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["browsingActivity"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
