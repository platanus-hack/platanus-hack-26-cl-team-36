{
  "manifest_version": 3,
  "name": "Chameleon",
  "version": "0.1.0",
  "description": "Cambia el diseño de sitios web aplicando el tema que indica la API (CSS + features).",

  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },

  "permissions": ["storage", "scripting"],

  "host_permissions": ["http://*/*", "https://*/*"],

  "background": {
    "scripts": ["background/index.js"],
    "type": "module"
  },

  "action": {
    "default_title": "Chameleon",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.svg",
      "32": "icons/icon.svg"
    }
  },

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "css": ["features/modo-foco.css", "features/vista.css", "componentes/cartelera.css", "content/transicion.css"],
      "js": [
        "content/registro.js",
        "comun/idioma.js",
        "content/captura.js",
        "content/plantillas.js",
        "content/transicion.js",
        "componentes/cartelera.js",
        "features/modo-foco.js",
        "features/vista.js",
        "content/motor.js"
      ],
      "run_at": "document_start"
    }
  ],

  "browser_specific_settings": {
    "gecko": {
      "id": "chameleon@grupo36.hackathon",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["browsingActivity"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
