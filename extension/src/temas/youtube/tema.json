{
  "nombre": "YouTube morado",
  "features": {
    "modo-foco": {
      "rutas": ["/watch"],
      "ancla": "ytd-watch-metadata #title"
    },
    "vista": [
      {
        "id": "portada",
        "rutas": ["/"],
        "contenedor": "ytd-browse[page-subtype=\"home\"] ytd-rich-grid-renderer",
        "items": "#contents > ytd-rich-item-renderer yt-lockup-view-model",
        "campos": {
          "titulo": { "selector": "a.ytLockupMetadataViewModelTitle" },
          "enlace": { "selector": "a.ytLockupMetadataViewModelTitle", "atributo": "href" },
          "imagen": [
            {
              "selector": "a.ytLockupViewModelContentImage",
              "atributo": "href",
              "patron": "[?&]v=([\\w-]{11})",
              "formato": "https://i.ytimg.com/vi/$1/hqdefault.jpg"
            },
            { "selector": "yt-thumbnail-view-model img", "atributo": "src" }
          ],
          "imagen_grande": {
            "selector": "a.ytLockupViewModelContentImage",
            "atributo": "href",
            "patron": "[?&]v=([\\w-]{11})",
            "formato": "https://i.ytimg.com/vi/$1/hq720.jpg"
          },
          "insignia": { "selector": ".ytBadgeShapeText" },
          "subtitulo": {
            "selector": ".ytContentMetadataViewModelMetadataRow:nth-of-type(1)",
            "partes": ".ytContentMetadataViewModelMetadataText",
            "separador": " • "
          },
          "detalle": {
            "selector": ".ytContentMetadataViewModelMetadataRow:nth-of-type(2)",
            "partes": ".ytContentMetadataViewModelMetadataText",
            "separador": " • "
          }
        },
        "accion": { "selector": "a.ytLockupMetadataViewModelTitle" },
        "componente": "cartelera",
        "opciones": {
          "fila": 8,
          "textos": {
            "es": {
              "titulo": "Para ti",
              "destacado": "Destacado",
              "boton": "Reproducir",
              "fila": "Sigue explorando",
              "lista": "Más videos",
              "original": "Ver YouTube original",
              "volver": "Volver a la cartelera"
            },
            "en": {
              "titulo": "For you",
              "destacado": "Featured",
              "boton": "Play",
              "fila": "Keep exploring",
              "lista": "More videos",
              "original": "View original YouTube",
              "volver": "Back to the lineup"
            }
          }
        }
      }
    ]
  },
  "eventosNavegacion": ["yt-navigate-finish"]
}
