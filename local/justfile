# Local environment. From anywhere in the repo, as `just local <command>`, in this order:
#
#   1. just local setup                      once, after cloning
#   2. just local up                         backend + Firefox with the extension, in the background
#      just local up sesion                  same, with the copy of your Firefox profile
#      just local down                       stops them
#   3. just local test                       before pushing
#   4. just local explore <url> "<task>"     synthetic users (calls Claude)
#
# Recipes run from the repo root, so every path here is relative to it. What `up`
# leaves behind (process ids and logs) goes to local/.state/, outside git.

set working-directory := '..'

state := "local/.state"
list_heading := "Run as `just local <command>`, in this order:\n"

# What `just local` alone runs.
[private]
[default]
help:
    @just --list local --unsorted --list-heading '{{ list_heading }}'

# ── 1. Setup ──────────────────────────────────────────────────────────────

# Checks requirements and installs all dependencies (safe to re-run)
[group('1. Setup · once, after cloning')]
setup:
    #!/usr/bin/env bash
    set -uo pipefail
    missing=0
    ok()   { echo "  ✔ $1"; }
    fail() { echo "  ✘ $1 → $2"; missing=$((missing + 1)); }

    echo "Checking requirements"
    if command -v node >/dev/null && command -v npm >/dev/null \
        && node -e 'process.exit(parseInt(process.versions.node) < 22 ? 1 : 0)'; then
        ok "Node.js $(node --version) and npm"
    else
        fail "Node.js 22 or newer, with npm" "brew install node"
    fi
    if [ -x /Applications/Firefox.app/Contents/MacOS/firefox ]; then
        ok "Firefox"
    else
        fail "Firefox" "brew install --cask firefox"
    fi
    if ! command -v uv >/dev/null && command -v brew >/dev/null; then
        brew install uv
    fi
    if command -v uv >/dev/null; then
        ok "uv"
    else
        fail "uv" "https://docs.astral.sh/uv/"
    fi
    # Only step 4 needs Claude Code, so it warns instead of stopping the setup.
    if ! command -v claude >/dev/null; then
        echo "  ! Claude Code is missing (needed for step 4) → https://claude.com/claude-code"
    elif claude auth status 2>/dev/null | grep -q '"loggedIn": *true'; then
        ok "Claude Code, logged in"
    else
        echo "  ! Claude Code is not logged in (needed for step 4) → claude auth login"
    fi
    if [ "$missing" -gt 0 ]; then
        echo "Fix the ✘ items and run \`just local setup\` again."
        exit 1
    fi

    set -e
    echo "Installing dependencies"
    npm install    # the root postinstall also installs extension/ (web-ext)
    cd agents/app/web_evaluator
    uv sync
    uv run playwright install chromium
    echo "Done. Next: \`just local up\`"

# ── 2. Run ────────────────────────────────────────────────────────────────

# `sesion` uses the copy of your Firefox profile in extension/.perfil-dev/ (make it with `npm run perfil:clonar`).
# Starts the backend (localhost:4747) and a separate Firefox with the extension, in the background
[group('2. Run')]
up profile="temporary": _ready
    #!/usr/bin/env bash
    set -euo pipefail
    case "{{ profile }}" in
        temporary) firefox=(npm run dev) ;;
        sesion)
            firefox=(npm run dev:sesion)
            if [ ! -d extension/.perfil-dev ]; then
                echo "  ! extension/.perfil-dev/ doesn't exist: Firefox starts with an empty profile that is kept." >&2
                echo "    To use a copy of your own profile, run \`npm run perfil:clonar\` first." >&2
            fi
            ;;
        *)
            echo "  ✘ Unknown profile \"{{ profile }}\": use \`just local up\` or \`just local up sesion\`." >&2
            exit 1
            ;;
    esac
    mkdir -p {{ state }}
    set -m    # each service gets its own process group, so `down` stops it with its children

    running() { [ -f "{{ state }}/$1.pid" ] && kill -0 -- "-$(cat "{{ state }}/$1.pid")" 2>/dev/null; }

    # start NAME DIR READY COMMAND...: launches COMMAND in DIR and waits until READY shows up in its log.
    start() {
        local name="$1" dir="$2" ready="$3"
        shift 3
        if running "$name"; then
            echo "  ✔ $name (already running)"
            return
        fi
        local log="{{ state }}/$name.log"
        (cd "$dir" && exec nohup "$@") > "$log" 2>&1 < /dev/null &
        echo $! > "{{ state }}/$name.pid"
        for _ in $(seq 120); do
            if grep -q "$ready" "$log"; then
                echo "  ✔ $name"
                return
            fi
            running "$name" || break
            sleep 0.25
        done
        echo "  ✘ $name did not start. Last lines of $log:" >&2
        tail -n 15 "$log" >&2
        echo "Stop whatever did start with \`just local down\`." >&2
        exit 1
    }

    if ! running backend; then
        taken="$(lsof -nP -iTCP:4747 -sTCP:LISTEN -t 2>/dev/null | head -n 1 || true)"
        if [ -n "$taken" ]; then
            echo "  ✘ port 4747 is already in use by: $(ps -o command= -p "$taken")" >&2
            echo "Stop that program and run \`just local up\` again." >&2
            exit 1
        fi
    fi
    start backend backend "localhost:4747" node --watch index.js
    if running firefox; then
        if [ "$(cat "{{ state }}/firefox.profile" 2>/dev/null || echo temporary)" != "{{ profile }}" ]; then
            echo "  ! Firefox is already running with another profile: \`just local down\` first to switch." >&2
        fi
    else
        echo "{{ profile }}" > "{{ state }}/firefox.profile"
    fi
    start firefox extension "as a temporary add-on" "${firefox[@]}"
    echo "Running. Follow the logs with \`just local logs\`, stop with \`just local down\`."

# Stops what `just local up` started
[group('2. Run')]
down:
    #!/usr/bin/env bash
    set -uo pipefail
    stopped=0
    for name in firefox backend; do
        pidfile="{{ state }}/$name.pid"
        [ -f "$pidfile" ] || continue
        group="$(cat "$pidfile")"
        rm -f "$pidfile"
        # Only touch it if it is still ours: a node or npm process leading that group.
        ps -o command= -p "$group" 2>/dev/null | grep -qE 'node|npm' || continue
        kill -INT -- "-$group"    # like Ctrl+C: web-ext closes its Firefox, node --watch its child
        for _ in $(seq 40); do
            kill -0 -- "-$group" 2>/dev/null || break
            sleep 0.25
        done
        kill -0 -- "-$group" 2>/dev/null && kill -KILL -- "-$group"
        echo "  ✔ stopped $name"
        stopped=1
    done
    [ "$stopped" -eq 1 ] || echo "Nothing was running."

# Follows the backend and Firefox logs (Ctrl+C to stop following)
[group('2. Run')]
logs:
    @test -f {{ state }}/backend.log || { echo "No logs yet: start with \`just local up\`." >&2; exit 1; }
    tail -n 30 -F {{ state }}/backend.log {{ state }}/firefox.log

# ── 3. Test ───────────────────────────────────────────────────────────────

# Backend and extension tests, extension lint and web_evaluator tests; does not call Claude
[group('3. Test · before pushing')]
test: _ready
    npm run check
    cd agents/app/web_evaluator && uv run pytest -q

# ── 4. Synthetic users ────────────────────────────────────────────────────

# Synthetic users try a task on a URL. E.g. just local explore https://example.cl "Find the opening hours" --profiles mobile
[group('4. Synthetic users · calls Claude, uses your plan')]
[working-directory('agents/app/web_evaluator')]
[positional-arguments]
explore url task *options: _ready
    #!/usr/bin/env bash
    set -euo pipefail
    url="$1" task="$2"
    shift 2
    exec uv run main.py --url "$url" --instruction "$task" ${1+"$@"}

# Runs the reference tasks in agents/tasks/ in parallel: all, or the ones whose id starts with wom, sii or dt
[group('4. Synthetic users · calls Claude, uses your plan')]
[working-directory('agents/app/web_evaluator')]
[positional-arguments]
validate task="all" *options: _ready
    #!/usr/bin/env bash
    set -euo pipefail
    prefix="${1:-all}"
    [ $# -gt 0 ] && shift
    [ "$prefix" = all ] && prefix=""
    ids=()
    for f in ../../tasks/"$prefix"*.json; do
        [ -e "$f" ] && ids+=("$(basename "$f" .json)")
    done
    if [ ${#ids[@]} -eq 0 ]; then
        echo "error: no task in agents/tasks/ starts with '$prefix'" >&2
        exit 1
    fi

    # Each task writes to agents/.runs/<id>/, so parallel runs don't collide.
    pids=()
    for id in "${ids[@]}"; do
        uv run main.py --task "$id" ${1+"$@"} 2>&1 | sed -u "s/^/[$id] /" &
        pids+=($!)
    done
    failures=0
    for pid in "${pids[@]}"; do wait "$pid" || failures=$((failures + 1)); done
    [ "$failures" -eq 0 ]

[private]
_ready:
    @test -x extension/node_modules/.bin/web-ext -a -x agents/app/web_evaluator/.venv/bin/python \
        || { echo "Dependencies are missing: run \`just local setup\` first." >&2; exit 1; }
