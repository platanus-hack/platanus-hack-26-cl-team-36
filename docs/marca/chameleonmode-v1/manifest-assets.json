  "symbol_policy": "La geometría y el orden del espectro originales se conservan. Los íconos instalables solo adaptan fondo y escala.",
  "extension_states": {
    "scope": "global_enablement",
    "on": "Espectro original: extensión habilitada globalmente",
    "off": "Símbolo neutro #A7A7B5 sobre baldosa original: extensión deshabilitada globalmente",
    "off_color": "#A7A7B5",
    "site_support_semantics": false,
    "brand_replacement": false,
    "geometry": "Maestros originales intactos, incluidos el ajuste óptico a 16 px, la baldosa y el ojo; sin filtros ni reducción de opacidad"
  },
  "wordmark": {
    "family": "Inter",
    "optical_size": 32,
    "chameleon_weight": 600,
    "mode_weight": 400,
    "mode_scale": 0.72,
    "baseline": "shared",
    "word_gap_em": 0.28,
    "tracking_em": -0.018,
    "outlined": true
  },
  "svg_policy": "Geometría vectorial; sin imágenes raster incrustadas, sin texto vivo ni fuentes externas.",
  "transparency_note": "Los lockups PNG tienen alfa real. La baldosa del símbolo color es parte de la marca; la transparencia queda fuera de ella. Apple/PWA/concurso/avatar/tarjeta social son opacos.",
  "print_note": "SVG es el maestro escalable. Para imprenta, acordar perfil CMYK y prueba de color con proveedor; no se promete equivalencia directa del espectro RGB.",
  "validation": {
    "svg_vector_only": true,
    "png_decode": true,
    "transparent_lockups": true,
    "ico_embedded_sizes": [
      16,
      32,
      48
    ],
    "extension_state_sizes": [
      16,
      32,
      48,
      96,
      128
    ],
    "extension_states_geometry_identical": true,
    "extension_states_alpha_identical": true,
    "extension_states_distinct_colors": true,
    "maskable_safe_circle_radius_px": 204.8,
    "maskable_max_symbol_radius_px": 186.876,
    "maskable_opaque": true,
    "avatar_circular_crop_safe": true,
    "avatar_max_symbol_radius_px": 373.549,
    "avatar_safe_circle_radius_px": 409.6,
    "social_card_size": [
      1200,
      630
    ],
    "social_card_opaque": true,
    "contest_under_500kb": true
  },
